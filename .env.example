# Aplicação
PORT=8080

# Banco de dados
DB_DRIVER=sqlite
DB_DSN=./estoque.db

# Migrations (lidas automaticamente pela CLI do goose)
GOOSE_DRIVER=sqlite3
GOOSE_DBSTRING=./estoque.db
GOOSE_MIGRATION_DIR=internal/infrastructure/database/migrations

# Assistente de IA (chat com orquestrador + agentes)
# Chave da API da Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo: claude-sonnet-5-5 (equilíbrio custo/qualidade), claude-haiku-5-5 (mais barato), claude-opus-5-5 (mais capaz)
CLAUDE_MODELO=claude-sonnet-5-5
# Esforço de raciocínio: low, medium, high, xhigh ou max (mais esforço = melhor e mais caro)
CLAUDE_ESFORCO=medium
